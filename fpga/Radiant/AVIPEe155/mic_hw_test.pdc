# Pin assignments for mic_hw_test_top on the UPduino v3.1 (iCE40UP5K-SG48).
# Pins come from the E155 FA23 v4 dev board and breadboard adapter schematics.
# J1/J3 are adapter header positions; SW0 and D6 are on the dev board.
# Keep DIP switch SW7 off: it ties MCU pins to P10, P12, P20, P21, P23, P25-27.
# Use this file instead of AVIPEe155.pdc when mic_hw_test_top is the top.
# clk comes from the internal HSOSC, so it has no pin.

# SPH0645 microphone (same pins as AVIPEe155.pdc). Power it from J3-2 (+3V3)
# and J3-1 (GND): J1 has only +5V and VIN.
ldc_set_location -site {11} [get_ports bclk]      ;# J1-4
ldc_set_location -site {6}  [get_ports ws]        ;# J1-5
ldc_set_location -site {48} [get_ports sd]        ;# J1-7

# active-low reset on dev board push button SW0 (to GND, internal pull-up)
ldc_set_location -site {34} [get_ports reset_b]   ;# SW0
ldc_set_port -iobuf {PULLMODE=100K} [get_ports reset_b]

# VU meter: 5 green LEDs on the adapter, bar[0] is the quietest level.
# Each LED: long leg (anode) to the pin, short leg through 330 ohm-1k to GND.
ldc_set_location -site {10} [get_ports {bar[0]}]  ;# J1-1
ldc_set_location -site {21} [get_ports {bar[1]}]  ;# J1-2
ldc_set_location -site {19} [get_ports {bar[2]}]  ;# J1-3
ldc_set_location -site {4}  [get_ports {bar[3]}]  ;# J1-6
ldc_set_location -site {47} [get_ports {bar[4]}]  ;# J1-8

# dev board blue LEDs: D6 heartbeat (1 Hz), D7 clip
ldc_set_location -site {42} [get_ports led_heartbeat] ;# D6
ldc_set_location -site {38} [get_ports led_clip]      ;# D7

# pcm stream (logic analyzer), SPI mode 0, 1.5 MHz
ldc_set_location -site {46} [get_ports pcm_sck]   ;# J3-12
ldc_set_location -site {45} [get_ports pcm_sdo]   ;# J3-13
ldc_set_location -site {3}  [get_ports pcm_cs_b]  ;# J3-14

# frame dump (logic analyzer), SPI mode 0, 1.5 MHz
ldc_set_location -site {44} [get_ports frm_sck]   ;# J3-15
ldc_set_location -site {9}  [get_ports frm_sdo]   ;# J3-16
ldc_set_location -site {18} [get_ports frm_cs_b]  ;# J3-17

# pcm samples to the PC: pin 14 drives the UPduino FT232H RXD (ADBUS1,
# through R12). Shows up on the PC as the UPduino's USB serial port.
ldc_set_location -site {14} [get_ports uart_tx]
